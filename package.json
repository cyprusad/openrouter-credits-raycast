{
  "name": "openrouter-credits",
  "title": "OpenRouter Credits",
  "description": "Monitor your OpenRouter API credits in the menu bar",
  "icon": "command-icon.png",
  "author": "Your Name",
  "license": "MIT",
  "commands": [
    {
      "name": "openrouter-credits",
      "title": "OpenRouter Credits",
